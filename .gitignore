# build output
target/

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath

# editor / agent workspace
.zcode/

# OS
.DS_Store

# secrets
.env
.env.*
!.env.example

# local config overrides. Spring names profile files application-local.yml (hyphen), which
# `*.local.yml` alone would not catch.
*.local.yml
application-local.*

# frontend
node_modules/

# playwright traces, screenshots and reports (written only when a run fails)
frontend/test-results/
frontend/playwright-report/

# built frontend copied into backend static (produced by the build)
backend/src/main/resources/static/*
!backend/src/main/resources/static/.gitkeep

# logs
*.log