# Authoritative for this tree: stops Lombok from picking up config above the repo root.
config.stopBubbling = true

# Copy DI-relevant annotations from a field onto the generated constructor parameter, so
# @RequiredArgsConstructor keeps @Qualifier/@Value meaningful.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
