# Copy to .env and fill in. .env is git-ignored; this template is not meant to hold a real key.

# Required. The qwen-max key from the assignment (DashScope, OpenAI-compatible endpoint).
DASHSCOPE_API_KEY=

# Optional overrides — the defaults match docker-compose.yml.
MYSQL_DATABASE=ordermgt
MYSQL_USER=ordermgt
MYSQL_PASSWORD=ordermgt
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306
APP_PORT=8081

# Local (non-Docker) runs read these instead. See README "本地运行".
# SPRING_PROFILES_ACTIVE=local
