# Copy to .env and fill in. .env is git-ignored; this template is not meant to hold a real key.
# .env is the single source of environment variables: docker-compose interpolates from it, the
# Makefile exports it to every target, and the app loads it directly (spring.config.import).

# The assistant's model gateway. Give it a key -- AI_API_KEY, or the assignment's own
# DASHSCOPE_API_KEY (the app falls back to it, so an .env written for that endpoint keeps working).
# With neither, the app starts but every model call fails; docker compose refuses to start.
AI_API_KEY=

# Optional: point the same OpenAI-compatible adapter at another gateway and model. Leave them
# commented out unless you set them -- an empty value is not a no-op, it would shadow the default
# in application.yml (and in docker-compose.yml, which carries its own copy of it). The base URL
# must NOT include /v1: Spring AI appends /v1/chat/completions itself.
# AI_BASE_URL=https://api.commandcode.ai/provider
# AI_MODEL=deepseek/deepseek-v4.1-flash

# The assignment's own key (DashScope, OpenAI-compatible endpoint).
DASHSCOPE_API_KEY=

# Optional overrides — the defaults match docker-compose.yml. Local (non-Docker) dev and the
# test suite read the same MYSQL_* variables, so a bare `./mvnw -pl backend spring-boot:run`
# reaches the resident container without any extra configuration.
MYSQL_DATABASE=ordermgt
MYSQL_USER=ordermgt
MYSQL_PASSWORD=ordermgt
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306
APP_PORT=8081

# No key? Add `offline` to the profile list to run against the keyword-driven mock adapter
# instead of the real model — see README「没有 Key 也能跑」. `mysql` is what supplies the
# datasource, so both are needed.
# SPRING_PROFILES_ACTIVE=mysql,offline
