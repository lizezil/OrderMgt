# Keep the build context small and make sure the image builds the app from source,
# not from whatever happens to be lying around locally.
.git
.gitignore
docs
*.md
target
**/target
node_modules
**/node_modules
frontend/dist
# The SPA is built inside the image (stage 1), so never ship a local build into the jar.
backend/src/main/resources/static
.idea
.vscode
*.log
.env
# .env.* too: a local override next to the real .env must not travel to the daemon either.
.env.*
# agent workspace and Playwright artifacts, never build inputs. Traces and videos land in
# test-results only when a run fails, and they can reach tens of MB.
.zcode
frontend/test-results
frontend/playwright-report
.DS_Store
